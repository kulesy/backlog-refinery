#!/bin/bash
# Start Backlog Refinery and open it. Idempotent: reuses a running server.
set -uo pipefail
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
[ "${1:-}" = init ] && { shift; exec node "$ROOT/scripts/init.mjs" "$@"; }
PORT="${PORT:-4380}"
if ! curl -fsS "http://localhost:$PORT/api/decisions" >/dev/null 2>&1; then
  gh auth status >/dev/null 2>&1 || { echo "gh is not authenticated. Run: gh auth login --insecure-storage"; exit 1; }
  ( cd "$ROOT" && nohup node server.mjs >> "$HOME/Library/Logs/backlog-refinery.log" 2>&1 & )
  for _ in $(seq 1 30); do curl -fsS "http://localhost:$PORT/api/decisions" >/dev/null 2>&1 && break; sleep 0.3; done
fi
open "http://localhost:$PORT"
